{
  "name": "daymark",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "dev": "pnpm --filter @daymark/shared build && concurrently -n server,web -c blue,green \"pnpm --filter @daymark/server dev\" \"pnpm --filter @daymark/web dev --host 0.0.0.0\"",
    "build": "pnpm -r build",
    "typecheck": "pnpm --filter @daymark/shared build && pnpm -r --filter '!@daymark/shared' typecheck",
    "test": "pnpm -r test",
    "clean": "rm -rf apps/*/dist packages/*/dist node_modules"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "typescript": "^5.9.3"
  }
}
